# Copy to .env and fill in. Never commit .env.

# SEC EDGAR — required for live quarterly facts
# Format: "AppName (contact@example.com)"
SEC_USER_AGENT=FinancialAnalystAgent (you@example.com)
SEC_BASE_URL=https://data.sec.gov
SEC_MAX_REQUESTS_PER_SECOND=8
# Per connect or read; a request as a whole, body included, gets the deadline.
SEC_TIMEOUT_SECONDS=10
SEC_REQUEST_DEADLINE_SECONDS=30
# Largest SEC response read, after decompression (64 MiB).
SEC_MAX_RESPONSE_BYTES=67108864
# SEC time one turn may spend; companies not read by then show "Source unavailable".
SEC_TURN_BUDGET_SECONDS=90
# After SEC's "undeclared automated tool" page, SEC requests stop for this long:
# a request during the pause is refused at once ("Source unavailable"), not held.
SEC_BLOCK_PAUSE_SECONDS=600
SEC_CACHE_DIR=.cache/sec
# The cache is trimmed, oldest files first, past this size (1 GiB).
SEC_CACHE_MAX_BYTES=1073741824
# How often the live runtime reads SEC's latest 10-Q and 10-K filings: a company's
# cached data then lasts until it files again (ADR 0013). 0 turns it off, and
# cached data is fetched again after an hour.
SEC_FILING_WATCH_SECONDS=300
# With the watch on, the largest companies' SEC data is fetched in the background
# before anyone asks (ADR 0014): this many companies (0 turns it off), at this
# share of the SEC request rate, waiting while visitors' requests queue.
SEC_WARM_COMPANIES=250
SEC_WARM_REQUESTS_PER_SECOND=2

# Financial Modeling Prep — snapshot build + batch market caps
# Use the current /stable endpoints, not discontinued /api/v3.
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# OpenAI — structured intent planner and explain essays
# Pin a Structured Outputs–capable model (v1 used gpt-4o-2024-11-20)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tavily — search_news backend (topic=news). Free-tier key is enough.
TAVILY_API_KEY=

# live = the live runtime (SEC/OpenAI/Tavily, local). recorded = the recorded runtime
# (captured responses, public demo default). "fixture" is a deprecated alias for recorded.
APP_MODE=recorded
PUBLIC_DEMO=false
# Shared secret the web proxy sends as X-Proxy-Token (ADR 0006). When set, the API
# refuses every call but /api/health that lacks it. Leave blank for local runs; set
# the same value on the hosted API and the web proxy. Blank on a public demo logs a
# startup warning.
API_PROXY_TOKEN=
DEMO_LIVE_SEC=false
ALLOW_PUBLIC_OPENAI=false
ALLOW_PUBLIC_TAVILY=false
THREAD_TTL_SECONDS=7200
MAX_TURNS_PER_THREAD=25
MAX_LIVE_SEC_REQUESTS_PER_THREAD=150
# Turns the API runs at once across all threads; one more is refused (429, busy).
MAX_CONCURRENT_TURNS=4
# A turn still running after this ends with an error and frees its thread and slot.
TURN_TIMEOUT_SECONDS=150
# Per visitor IP, per rolling hour, when the Next.js proxy forwards it (needs API_PROXY_TOKEN).
CLIENT_THREADS_PER_HOUR=30
CLIENT_TURNS_PER_HOUR=120
SNAPSHOT_STALE_AFTER_DAYS=30
